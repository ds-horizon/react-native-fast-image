{
  "mcpServers": {
    "expo-mcp": {
      "type": "http",
      "url": "https://mcp.expo.dev/mcp"
    },
    "rn-debugger": {
      "type": "stdio",
      "command": "npx",
      "args": ["react-native-ai-debugger"]
    },
    "react-native-debugger-mcp": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@twodoorsdev/react-native-debugger-mcp"]
    }
  }
}
